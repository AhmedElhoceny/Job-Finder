# =====================================================================
# Google Gemini API Configuration (Free Tier via Google AI Studio)
# Get your free key at: https://aistudio.google.com/app/apikey
# =====================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended free tier models: gemini-3.5-flash (primary), gemini-3.5-flash-lite (fallback)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Free tier rate limits (15 requests per minute, safety buffer at 12 RPM)
GEMINI_MAX_RPM=12
GEMINI_REQUEST_DELAY_SECONDS=4.0

# Database & Storage
DATABASE_PATH=data/jobs.db

# Logging
LOG_LEVEL=INFO
